#!/usr/bin/env node
// A native app-server test peer that waits for a real approval reply.
import readline from 'node:readline';
const emit = value => process.stdout.write(`${JSON.stringify(value)}\n`);
const event = (method, params) => emit({method, params});
readline.createInterface({input:process.stdin}).on('line', line => {
  const message = JSON.parse(line);
  const {method,id} = message;
  if (method === 'initialize') emit({id,result:{}});
  else if (method === 'thread/start' || method === 'thread/resume') emit({id,result:{thread:{id:'test-thread'}}});
  else if (method === 'turn/start') {
    emit({id,result:{turn:{id:'test-turn'}}});
    event('turn/started',{threadId:'test-thread',turn:{id:'test-turn'}});
    const params={threadId:'test-thread',turnId:'test-turn'};
    const mcp=process.env.REVIEW_TEST_APPROVAL === 'mcp';
    Object.assign(params,mcp ? {message:'Allow the review helper to inspect the diff?',_meta:{codex_approval_kind:'mcp_tool_call'},requestedSchema:{type:'object',properties:{}}} : {command:'git diff -- calculator.rs',reason:'Read the changes to prepare the walkthrough.'});
    emit({id:'prepare-approval',method:mcp ? 'mcpServer/elicitation/request' : 'item/commandExecution/requestApproval',params});
  } else if (!method && id === 'prepare-approval') {
    const accepted=message.result.decision === 'accept' || message.result.action === 'accept';
    const guide=process.env.REVIEW_TEST_APPROVAL === 'diff'
      ? '# Fix addition\n\nReplace subtraction while preserving the surrounding function.\n\n```rust {"file":"calculator.rs","diff":true}\n@@ -1,3 +1,3 @@\n pub fn add(a: i32, b: i32) -> i32 {\n-    a - b\n+    a + b\n }\n```\n'
      : '# Approved walkthrough\n\nPrepared after your approval.\n\n```rust {"file":"calculator.rs","start":1}\npub fn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n```\n';
    if (accepted) event('item/completed',{threadId:'test-thread',item:{id:'guide',type:'agentMessage',phase:'final_answer',text:guide}});
    event('turn/completed',{threadId:'test-thread',turn:{status:accepted ? 'completed' : 'interrupted'}});
  } else if (method === 'turn/interrupt') {
    emit({id,result:{}});
    event('turn/completed',{threadId:'test-thread',turn:{status:'interrupted'}});
  }
});
