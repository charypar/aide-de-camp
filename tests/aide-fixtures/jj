#!/usr/bin/env python3
"""Real jj with an optional deterministic fetch gate for concurrency tests."""
import os, sys, time
from pathlib import Path

if sys.argv[1:3] == ['git', 'fetch'] and os.environ.get('AIDE_FIXTURE_FETCH_GATES'):
    base=Path(os.environ['AIDE_FIXTURE_FETCH_GATES'])
    gate=base/(Path.cwd().name+'.hold')
    if gate.exists():
        with (base/(Path.cwd().name+'.entered')).open('a') as log:
            log.write('fetch\n')
        deadline=time.monotonic()+45
        while gate.exists():
            if time.monotonic()>deadline:sys.exit('Fixture fetch gate timed out')
            time.sleep(.05)
if sys.argv[1:3] == ['workspace', 'forget'] and os.environ.get('AIDE_FIXTURE_CLEANUP_GATE'):
    gate=Path(os.environ['AIDE_FIXTURE_CLEANUP_GATE'])
    gate.with_suffix('.entered').write_text('cleanup')
    deadline=time.monotonic()+45
    while gate.exists():
        if time.monotonic()>deadline:sys.exit('Fixture cleanup gate timed out')
        time.sleep(.05)
    if gate.with_suffix('.fail').exists():sys.exit('Fixture cleanup failure')
os.execv(os.environ['AIDE_FIXTURE_REAL_JJ'], ['jj', *sys.argv[1:]])
