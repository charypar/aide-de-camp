#!/usr/bin/env python3
"""Controlled native-protocol fixture. No model or network calls."""
import base64, hashlib, json, os, signal, socket, struct, subprocess, sys, threading, time
import sqlite3
from pathlib import Path

def frame(conn, value, masked=False):
    data=json.dumps(value).encode(); n=len(data)
    header=bytes([129, (128 if masked else 0) | (n if n<126 else 126)])
    if n>=126: header+=struct.pack('!H', n)
    if masked:
        mask=b'abcd'; header+=mask; data=bytes(b^mask[i%4] for i,b in enumerate(data))
    conn.sendall(header+data)

def exact(conn,n):
    data=b''
    while len(data)<n:
        part=conn.recv(n-len(data))
        if not part: raise EOFError()
        data+=part
    return data

def receive(conn):
    a,b=exact(conn,2); n=b&127
    if n==126:n=struct.unpack('!H',exact(conn,2))[0]
    if n==127:n=struct.unpack('!Q',exact(conn,8))[0]
    mask=exact(conn,4) if b&128 else None
    data=exact(conn,n)
    if mask:data=bytes(v^mask[i%4] for i,v in enumerate(data))
    if a&15==8:raise EOFError()
    return json.loads(data)

def handshake(conn, client=False):
    if client:conn.sendall(b'GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n')
    raw=b''
    while not raw.endswith(b'\r\n\r\n'):raw+=exact(conn,1)
    if not client:
        key=[l.split(b':',1)[1].strip() for l in raw.split(b'\r\n') if l.lower().startswith(b'sec-websocket-key:')][0]
        digest=base64.b64encode(hashlib.sha1(key+b'258EAFA5-E914-47DA-95CA-C5AB0DC85B11').digest())
        conn.sendall(b'HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: '+digest+b'\r\n\r\n')

args=sys.argv[1:]
if '--version' in args:print('codex fixture');sys.exit()
if args and args[0]=='app-server':
    if os.environ.get('AIDE_FIXTURE_STARTUP_GATE'):
        gate=Path(os.environ['AIDE_FIXTURE_STARTUP_GATE'])
        gate.with_suffix('.entered').write_text('startup')
        deadline=time.monotonic()+45
        while gate.exists():
            if time.monotonic()>deadline:sys.exit('Fixture startup gate timed out')
            time.sleep(.05)
        if gate.with_suffix('.fail').exists():sys.exit('Fixture backend startup failure')
    endpoint=args[args.index('--listen')+1][7:]
    server=socket.socket(socket.AF_UNIX);server.bind(endpoint);server.listen()
    Path('.fixture-backend.json').write_text(json.dumps({'pid':os.getpid(), 'environment':{k:v for k,v in os.environ.items() if k.startswith('AIDE_TEST_')}}))
    state={'thread':None}
    default_instructions=None
    if '--config' in args:
        value=args[args.index('--config')+1]
        if value.startswith('developer_instructions='):
            default_instructions=json.loads(value.split('=',1)[1])
    root=Path(os.environ['AIDE_FIXTURE_RECORDINGS']); root.mkdir(exist_ok=True)
    def other_thread():
        if not state['thread'] or not Path('.fixture-other-thread').exists(): return None
        if Path('.fixture-other-thread').read_text().strip()=='thread_title':
            return {'id':'other-fixture','path':None,'cwd':os.getcwd(),'status':{'type':'idle'},'name':None,'source':'vscode','threadSource':'thread_title'}
        path=root/'other-fixture.jsonl'
        if not path.exists():path.write_text('unrelated conversation\n')
        return {'id':'other-fixture','path':str(path),'cwd':os.getcwd(),'status':{'type':'idle'},'name':'Unrelated conversation'}
    def serve(conn):
        try:
            handshake(conn)
            while True:
                request=receive(conn);method=request.get('method');params=request.get('params',{})
                if 'id' not in request:continue
                error=None;result={}
                if method=='initialize':result={'platformFamily':'unix','platformOs':'macos','userAgent':'fixture'}
                elif method=='config/read':
                    if Path('.fixture-config-error').exists():error={'message':'Fixture configuration failure'}
                    else:result={'config':{'developer_instructions':'Existing native preferences'}}
                elif method=='thread/loaded/list':
                    other=other_thread()
                    result={'data':([other['id']] if other else [])+([state['thread']['id']] if state['thread'] else [])}
                elif method=='thread/list':
                    threads=[]
                    if not params.get('archived'):
                        for path in root.glob('*.jsonl'):
                            try:meta=json.loads(path.read_text().splitlines()[0])
                            except (ValueError,IndexError):continue
                            threads.append({'id':meta['id'],'cwd':meta['cwd'],'name':meta.get('name','Fixture conversation'),'updatedAt':1,'source':'cli','threadSource':'user'})
                    result={'data':threads,'nextCursor':None}
                elif method=='thread/fork':
                    if Path('.fixture-picker-protocol').exists():
                        frame(conn,{'id':request['id'],'method':'item/commandExecution/requestApproval','params':{'threadId':params['threadId']}})
                        approval=receive(conn)
                        assert approval=={'id':request['id'],'result':{'decision':'accept'}}
                        Path('.fixture-native-approval').write_text(json.dumps(approval))
                        frame(conn,{'id':'unrelated','result':{'thread':{'id':'wrong-fork'}}})
                        frame(conn,{'method':'thread/started','params':{'thread':{'id':'notification-only'}}})
                    source=root/(params['threadId']+'.jsonl')
                    if Path('.fixture-fork-error').exists():error={'message':'Fixture fork failure'}
                    elif not source.exists():error={'message':'Missing source history'}
                    else:
                        identity='fork-'+str(time.time_ns())
                        path=root/(identity+'.jsonl')
                        cwd=params.get('cwd',os.getcwd())
                        path.write_text(json.dumps({'id':identity,'cwd':cwd})+'\n'+source.read_text())
                        state['thread']={'id':identity,'path':str(path),'cwd':cwd,'status':{'type':'idle'},'name':'Forked conversation'}
                        Path('.fixture-fork-params').write_text(json.dumps(params))
                        result={'thread':state['thread']}
                elif method in ('thread/start','thread/resume'):
                    identity=params.get('threadId') or 'fixture-'+str(time.time_ns())
                    path=root/(identity+'.jsonl')
                    if method=='thread/resume' and not path.exists():error={'message':'Missing native recording'}
                    else:
                        effective=params.get('developerInstructions', default_instructions)
                        if effective is not None:
                            Path('.fixture-instructions').write_text(effective)
                        if not path.exists():path.write_text(json.dumps({'id':identity,'cwd':params.get('cwd',os.getcwd())})+'\n')
                        state['thread']={'id':identity,'path':str(path),'cwd':os.getcwd(),'status':{'type':'idle'},'name':'Fixture conversation'}
                        result={'thread':state['thread']}
                elif method=='thread/read':
                    known=state['thread'] or {}
                    other=other_thread()
                    selected=known if known.get('id')==params.get('threadId') else other
                    if not selected or selected.get('id')!=params.get('threadId'):
                        saved=root/(params['threadId']+'.jsonl')
                        if saved.exists():
                            meta=json.loads(saved.read_text().splitlines()[0])
                            selected={'id':meta['id'],'cwd':meta['cwd'],'path':str(saved),'status':{'type':'notLoaded'},'threadSource':'user'}
                        else:error={'message':'Unknown thread'}
                    t=dict(selected or {})
                    control=Path(os.getcwd())/'.fixture-status'
                    if control.exists():t['status']=json.loads(control.read_text())
                    summary=Path(os.getcwd())/'.fixture-summary'
                    if summary.exists():t['name']=summary.read_text()
                    result={'thread':t}
                elif method=='mcpServerStatus/list':result={'data':[]}
                else:error={'message':'Unexpected request '+str(method)}
                frame(conn, {'id':request['id'],**({'error':error} if error else {'result':result})})
        except (EOFError,ConnectionError,OSError):pass
        finally:conn.close()
    while True:
        conn,_=server.accept();threading.Thread(target=serve,args=(conn,),daemon=True).start()
else:
    endpoint=args[args.index('--remote')+1][7:]
    conn=socket.socket(socket.AF_UNIX);conn.connect(endpoint);handshake(conn,True)
    def call(i,m,p):
        frame(conn,{'id':i,'method':m,'params':p},True)
        while True:
            response=receive(conn)
            if response.get('method')=='item/commandExecution/requestApproval':
                frame(conn,{'id':response['id'],'result':{'decision':'accept'}},True)
            elif 'method' not in response and response.get('id')==i:
                return response
    call(1,'initialize',{})
    # Native remote TUI does not forward developer_instructions CLI overrides.
    # Keep this boundary realistic: only backend configuration supplies defaults.
    if args and args[0]=='fork':
        assert '--all' in args
        print('Fixture native fork picker',flush=True)
        call(2,'thread/list',{})
        selected=sys.stdin.readline().strip()
        if selected in ('','q'):sys.exit(0)
        if Path('.fixture-picker-protocol').exists():
            assert 'error' in call(9,'thread/start',{})
        response=call(3,'thread/fork',{'threadId':selected,'cwd':'/wrong/source/workspace','developerInstructions':'Wrong source instructions','excludeTurns':True})
        if 'error' in response:
            print(response['error']['message'],flush=True)
            sys.exit(0)
        # The binding must already be durable before the native UI sees success.
        with sqlite3.connect(Path(os.getcwd()).parents[1]/'.aide/state.sqlite') as db:
            current=json.loads(db.execute('SELECT body FROM tasks WHERE id=?',(Path(os.getcwd()).name,)).fetchone()[0])
        assert current['thread_id']==response['result']['thread']['id']
        print('Fixture native selection pinned before reply',flush=True)
    elif args and args[0]=='resume':response=call(2,'thread/resume',{'threadId':args[1]})
    else:response=call(2,'thread/start',{})
    print('Fixture Codex conversation ready',flush=True)
    # Ctrl-D/EOF returns to the real fish shell; normal commands are not run.
    child=subprocess.Popen(['sleep','120']) if os.environ.get('AIDE_FIXTURE_UI_CHILD') else None
    try:
        for line in sys.stdin:
            print('Fixture input: '+line.strip(),flush=True)
    finally:
        if child:
            child.terminate();child.wait()
